# Copy to backend/.env. All values are optional for local development.

# Unset = embedded Postgres (PGlite) in backend/.data
# DATABASE_URL=postgres://app:app@localhost:5432/document_approval

# Required in production
# JWT_SECRET=change-me

PORT=3000

# local | blob (blob is picked automatically when BLOB_READ_WRITE_TOKEN is set)
# STORAGE_DRIVER=local
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=4

# RATE_LIMIT=off
