{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && yarn install --frozen-lockfile",
  "buildCommand": "yarn build && yarn db:setup:prod",
  "outputDirectory": "public",
  "redirects": [{ "source": "/", "destination": "/api/docs", "permanent": false }],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 15 }
  }
}
