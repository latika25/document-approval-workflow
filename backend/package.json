{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/db/cli.ts setup",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:setup:prod": "node dist/db/cli.js setup"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@valibot/to-json-schema": "^1.8.0",
    "@vercel/blob": "^2.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vite": "^8",
    "vitest": "^4.1.12"
  }
}
